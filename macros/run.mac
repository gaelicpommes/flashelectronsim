# macros/run.mac  (small run for checking)

/control/macroPath macros

/run/verbose 1
/event/verbose 0
/tracking/verbose 0

# Initialize first so SourceCutoffPV exists for /gps/pos/confine.
/run/initialize

# Keep batch runs aligned with the legacy Gaussian source.
/control/execute source.mac
/run/beamOn 10
/vis/viewer/flush
