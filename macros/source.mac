# macros/source.mac  (Geant4 GPS - TOPAS-equivalent source at BeamPosition)

/gps/particle e-
/gps/ene/type Mono
/gps/ene/mono 9.5 MeV

# TOPAS source: Flat ellipse, CutoffX=CutoffY=2.2 mm, BeamPosition TransY=121.65 mm, RotX=-90 deg.
# The CAD converter maps TOPAS -Y to Geant4 +Z, so TOPAS Y=121.65 mm becomes G4 Z=-121.65 mm.
/gps/pos/type Plane
/gps/pos/shape Circle
/gps/pos/centre 0 0 -121.65 mm
/gps/pos/radius 2.2 mm

# TOPAS RotX=-90 deg points the beam down TOPAS -Y, mapped here to +Z.
/gps/direction 0 0 1
